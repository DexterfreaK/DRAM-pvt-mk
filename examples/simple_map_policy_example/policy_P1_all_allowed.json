{
    "helper_func": [
        "bpf_map_update_elem",
        "bpf_map_lookup_elem"
    ],
    "map_access": [
        {"name": "read_only",  "access": "Read"},
        {"name": "write_only", "access": "Write"},
        {"name": "read_write", "access": "ReadWrite"},
        {"name": "no_access",  "access": "ReadWrite"}
    ],
    "packet_constraints": [
        {
            "sPort": "*",
            "dPort": "*",
            "sIP": "*",
            "dIP": "*",
            "read-access":  ["0-1500"],
            "write-access": ["0-1500"]
        }
    ]
}
